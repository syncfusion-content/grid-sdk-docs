<ejs-pivotview id="PivotView" height="300">
    <e-datasourcesettings dataSource="@ViewBag.DataSource" expandAll="false">
        <e-rows>
            <e-field name="Country"></e-field>
            <e-field name="Products"></e-field>
        </e-rows>
        <e-columns>
            <e-field name="Year" caption="Year"></e-field>
            <e-field name="Quarter"></e-field>
        </e-columns>
        <e-values>
            <e-field name="Sold" caption="Units Sold" type="DifferenceFrom" baseField="Year" baseItem="(previous)" allowCrossGroupCalculation="true"></e-field>
            <e-field name="Amount" caption="Sold Amount" type="Sum"></e-field>
        </e-values>
    </e-datasourcesettings>
</ejs-pivotview>
