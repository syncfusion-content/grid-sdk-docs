<div class="controls" style="padding: 10px 0">
    <button class="e-btn" id="flashRows">Flash selected row</button>
    <button class="e-btn" id="flashColumn">Flash Exposure column</button>
    <button class="e-btn" id="flashCells">Flash cells</button>
</div>
<ejs-grid id="Grid" dataSource="@ViewBag.DataSource" enableHighlightOnDataChange="true" height="300">
    <e-grid-columns>
        <e-grid-column field="Account" headerText="Account" width="110" isPrimaryKey="true"></e-grid-column>
        <e-grid-column field="Desk" headerText="Desk" width="150"></e-grid-column>
        <e-grid-column field="Rating" headerText="Rating" width="100"></e-grid-column>
        <e-grid-column field="Exposure" headerText="Exposure" width="140" format="C0" textAlign="Right"></e-grid-column>
        <e-grid-column field="Risk" headerText="Risk level" width="110"></e-grid-column>
    </e-grid-columns>
</ejs-grid>
<script>
    document.getElementById('flashRows').addEventListener('click', function () {
        var grid = document.getElementById('Grid').ej2_instances[0];
        var rows = grid.getSelectedRowIndexes();
        if (rows.length) {
            grid.flashCells({ rowNodes: rows });
        }
    });
    document.getElementById('flashColumn').addEventListener('click', function () {
        var grid = document.getElementById('Grid').ej2_instances[0];
        grid.flashCells({ columns: ['Exposure'] });
    });
    document.getElementById('flashCells').addEventListener('click', function () {
        var grid = document.getElementById('Grid').ej2_instances[0];
        grid.flashCells({ rowNodes: [0, 2], columns: ['Rating', 'Exposure'] });
    });
</script>
