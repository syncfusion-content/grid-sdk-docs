@Html.EJS().Grid("grid").DataSource((IEnumerable<object>)ViewBag.dataSource).Height("400px").Columns(col =>
{
  col.Field("OrderID").HeaderText("Order ID").Width("120").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
  col.Field("CustomerName").HeaderText("Customer Name").Width("160").Add();
  col.Field("ShipCity").HeaderText("Ship City").Width("140").Add();
  col.Field("ShipCountry").HeaderText("Ship Country").Width("140").Add();
  col.Field("Freight").HeaderText("Freight").Width("120").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
}).AllowGrouping().GroupSettings(group => { group.Columns(new string[] { "ShipCountry", "ShipCity" }).DefaultExpanded(1); }).Render()