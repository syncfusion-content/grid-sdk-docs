@Html.EJS().Grid("grid").DataSource((IEnumerable<object>)ViewBag.dataSource).Height("320px").EnableToolPanel(true).EditSettings(e => { e.AllowEditing(true).Mode(Syncfusion.EJ2.Grids.EditMode.Normal); }).SelectionSettings(s => { s.Type(Syncfusion.EJ2.Grids.SelectionType.Multiple); }).Columns(col =>
{
  col.Field("EmployeeID").HeaderText("Employee ID").Width("140").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).IsPrimaryKey(true).Add();
  col.Field("Name").HeaderText("Name").Width("140").Add();
  col.Field("Title").HeaderText("Title").Width("140").Add();
  col.Field("Country").HeaderText("Country").Width("140").Add();
  col.Field("Salary").HeaderText("Salary").Width("140").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Format("C0").Add();
}).ToolPanelSettings(tp => tp.Position("Right").IsOpen(true).DefaultToolPanel("editing").ToolPanels(panels =>
{
  panels.Id("editing").Type("Edit").HeaderText("Editing").Add();
