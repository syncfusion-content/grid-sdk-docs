<ejs-grid id="grid" dataSource="@ViewBag.dataSource" height="320px" enableToolPanel="true">
    <e-grid-editSettings allowEditing="true" mode="Normal"></e-grid-editSettings>
    <e-grid-selectionsettings type="Multiple"></e-grid-selectionsettings>
    <e-grid-columns>
        <e-grid-column field="OrderID" headerText="Order ID" width="140" textAlign="Right" isPrimaryKey="true"></e-grid-column>
        <e-grid-column field="CustomerID" headerText="Customer ID" width="140"></e-grid-column>
        <e-grid-column field="ShipCity" headerText="Ship City" width="140"></e-grid-column>
        <e-grid-column field="ShipCountry" headerText="Ship Country" width="140"></e-grid-column>
        <e-grid-column field="Freight" headerText="Freight" width="140" textAlign="Right" format="C2"></e-grid-column>
    </e-grid-columns>
    <e-grid-toolpanelsettings position="Right" isOpen="true" defaultToolPanel="editing">
        <e-toolpanels>
            <e-toolpanel id="editing" type="Edit" headerText="Editing"></e-toolpanel>
            <e-toolpanel id="columns" type="Columns" headerText="Columns"></e-toolpanel>
        </e-toolpanels>
    </e-grid-toolpanelsettings>
</ejs-grid>
