<ejs-grid id="grid" dataSource="@ViewBag.dataSource" height="320px" enableToolPanel="true">
    <e-grid-columns>
        <e-grid-column field="OrderID" headerText="Order ID" width="140" textAlign="Right"></e-grid-column>
        <e-grid-column field="CustomerID" headerText="Customer ID" width="140"></e-grid-column>
        <e-grid-column field="ShipCity" headerText="Ship City" width="140"></e-grid-column>
        <e-grid-column field="ShipCountry" headerText="Ship Country" width="140"></e-grid-column>
        <e-grid-column field="Freight" headerText="Freight" width="140" textAlign="Right" format="C2"></e-grid-column>
    </e-grid-columns>
    <e-grid-toolpanelsettings position="Left" isOpen="true" defaultToolPanel="columns">
        <e-toolpanels>
            <e-toolpanel id="columns" type="Columns" headerText="Columns"></e-toolpanel>
            <e-toolpanel id="summary" type="Custom" headerText="Summary" iconCss="e-icons e-description" template="#customPanelTemplate"></e-toolpanel>
        </e-toolpanels>
    </e-grid-toolpanelsettings>
</ejs-grid>

<script id="customPanelTemplate" type="text/x-template">
    <div class="custom-panel"><h4>Order Summary</h4><p>Total orders: 8</p><p>Select a row to review the order here.</p></div>
</script>
