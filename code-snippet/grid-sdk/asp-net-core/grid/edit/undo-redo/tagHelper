<ejs-grid id="grid" dataSource="@ViewBag.DataSource" height="273px" toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Undo", "Redo" })">
  <e-grid-editSettings allowAdding="true" allowDeleting="true" allowEditing="true" enableUndoRedo="true" mode="Batch"></e-grid-editSettings>
  <e-grid-columns>
    <e-grid-column field="ItemID" headerText="Item ID" validationRules="@(new { required=true})" isPrimaryKey="true" textAlign="Right" width="100"></e-grid-column>
    <e-grid-column field="ItemName" headerText="Item Name" validationRules="@(new { required=true})" width="140"></e-grid-column>
    <e-grid-column field="Category" headerText="Category" editType="dropdownedit" width="130"></e-grid-column>
    <e-grid-column field="Stock" headerText="Stock" textAlign="Right" editType="numericedit" validationRules="@(new { required=true, min=0})" width="100"></e-grid-column>
    <e-grid-column field="Price" headerText="Price" textAlign="Right" format="C2" editType="numericedit" validationRules="@(new { required=true, min=1})" width="110"></e-grid-column>
  </e-grid-columns>
</ejs-grid>
