<ejs-grid id="grid" enableInfiniteScrolling="true" height="300">
    <e-data-manager url="https://services.syncfusion.com/js/production/api/UrlDataSource" adaptor="UrlAdaptor"></e-data-manager>
    <e-grid-pageSettings pageSize="50"></e-grid-pageSettings>
    <e-grid-infiniteScrollSettings enableCountLessMode="true"></e-grid-infiniteScrollSettings>
    <e-grid-columns>
        <e-grid-column field="OrderID" headerText="Order ID" textAlign="Right" width="100"></e-grid-column>
        <e-grid-column field="CustomerID" headerText="Customer ID" width="120"></e-grid-column>
        <e-grid-column field="ShipCity" headerText="Ship City" width="120"></e-grid-column>
        <e-grid-column field="ShipCountry" headerText="Ship Country" width="130"></e-grid-column>
    </e-grid-columns>
</ejs-grid>