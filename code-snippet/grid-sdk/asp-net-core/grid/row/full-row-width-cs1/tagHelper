<ejs-grid id="Grid" dataSource="@ViewBag.DataSource" gridLines="Both" allowTextWrap="true" height="315" width="auto" queryCellInfo="queryCellInfo">
    <e-grid-textwrapsettings wrapMode="Content"></e-grid-textwrapsettings>
    <e-grid-columns>
        <e-grid-column field="Name" headerText="Doctor Name" width="170" textAlign="Center" template="#doctorTemplate"></e-grid-column>
        <e-grid-column field="Time9AM" headerText="9:00 AM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time10AM" headerText="10:00 AM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time11AM" headerText="11:00 AM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time12PM" headerText="12:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time1PM" headerText="1:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time2PM" headerText="2:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time3PM" headerText="3:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time4PM" headerText="4:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time5PM" headerText="5:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time6PM" headerText="6:00 PM" width="120" textAlign="Center"></e-grid-column>
        <e-grid-column field="Time7PM" headerText="7:00 PM" width="120" textAlign="Center"></e-grid-column>
    </e-grid-columns>
</ejs-grid>

<script type="text/x-template" id="doctorTemplate">
    <div class="doctor-name">${Name}</div>
    <div class="doctor-designation">${Designation}</div>
    ${if(window.isFullWidthStatus(Status))}<div>${Status}</div>${/if}
</script>

<style>
    .doctor-name {
        margin-bottom: 5px;
    }

    .doctor-designation {
        font-size: 12px;
        color: #7f8c8d;
        font-weight: normal;
    }

    .e-grid .e-rowcell.full-width-row {
        background-color: #8b4242;
        color: #333;
        font-weight: 500;
    }
</style>

<script>
    function isFullWidthStatus(status) {
        if (!status) {
            return false;
        }
        var normalizedStatus = status.trim().toLowerCase().replace(/[-_]/g, ' ');
        return normalizedStatus === 'not available' || normalizedStatus === 'leave' ||
            normalizedStatus === 'on leave' || normalizedStatus === 'resigned';
    }

    function queryCellInfo(args) {
        if (args.column.field === 'Name' && isFullWidthStatus(args.data.Status)) {
            args.colSpan = 12;
            args.cell.classList.add('full-width-row');
        }
    }
</script>
