<div style="padding: 20px 0px 0px 0px">
    @Html.EJS().Button("button").CssClass("e-outline").Content("Deselect Rows at Index 1, 2, 3").Render()
</div>
<div style="padding: 20px 0px 0px 0px">
    @Html.EJS().Grid("grid").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowPaging().PageSettings(page => page.PageSize(5)).Height("348px").Columns(col =>
{
  col.Field("OrderID").HeaderText("Order ID").Width("120").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
  col.Field("CustomerID").HeaderText("Customer ID").Width("120").Add();
  col.Field("ShipCountry").HeaderText("Ship Country").Width("130").Add();
  col.Field("Freight").HeaderText("Freight").Width("120").Format("C2").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
}).SelectionSettings(select => select.Type(Syncfusion.EJ2.Grids.SelectionType.Multiple).Mode(Syncfusion.EJ2.Grids.SelectionMode.Row)).Render()
</div>
<script>
    document.getElementById('button').onclick = function () {
        var grid = document.getElementById("grid").ej2_instances[0];
        grid.selectionModule.deselectRows([1, 2, 3]);
    };
</script>