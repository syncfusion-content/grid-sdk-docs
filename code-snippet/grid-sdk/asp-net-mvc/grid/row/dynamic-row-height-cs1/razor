@using Syncfusion.EJ2

@Html.EJS().Grid("Grid").DataSource((IEnumerable<object>)ViewBag.DataSource).EnableDomVirtualization(true).Height("400px").SetRowHeight("setRowHeight").Columns(col =>
{
    col.Field("IssueId").HeaderText("Issue ID").Width("130").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
    col.Field("Title").HeaderText("Title").Width("260").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
    col.Field("Priority").HeaderText("Priority").Width("100").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).Add();
    col.Field("Status").HeaderText("Status").Width("110").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).Add();
    col.Field("Reporter").HeaderText("Reported By").Width("150").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
}).Render()

<script>
    function setRowHeight(row) {
        if (row.data.Priority === 'Critical') {
            return 60;
        } else if (row.data.Priority === 'High') {
            return 50;
        }
        return 36;
    }
</script>
