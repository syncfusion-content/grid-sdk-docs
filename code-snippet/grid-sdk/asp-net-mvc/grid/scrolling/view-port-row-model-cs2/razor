<style>
    .e-grid .e-row {
        line-height: 40px;
    }
    
    .e-grid .e-headercell {
        background-color: #f5f5f5;
        font-weight: 600;
    }
    
    .e-grid {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .e-toolbar {
        padding: 8px 12px;
    }
    
    .e-toolbar .e-toolbar-item {
        margin-right: 8px;
    }
    
    .vp-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .vp-badge { display: inline-flex; gap: 6px; align-items: center; padding: 2px 8px; border-radius: 12px; background: #eef2f7; font-size: 13px; }
    .vp-status-Active { background: #dcfce7; color: #166534; }
    .vp-status-Inactive { background: #f3f4f6; color: #4b5563; }
    .vp-status-OnLeave { background: #fef3c7; color: #92400e; }
    .vp-status-Retired { background: #fee2e2; color: #991b1b; }
    .vp-trust-Perfect { background: #dcfce7; color: #166534; }
    .vp-trust-Sufficient { background: #fef3c7; color: #92400e; }
    .vp-trust-Insufficient { background: #fee2e2; color: #991b1b; }
    .vp-progress { display: flex; align-items: center; gap: 6px; }
    .vp-progress-bar { flex: 1; height: 6px; background: #e5e7eb; border-radius: 3px; overflow: hidden; }
    .vp-progress-bar div { height: 100%; }
    .vp-salary { font-weight: 600; color: #059669; }
</style>
@Html.EJS().Grid("grid").DataSource(dm => dm.Url("https://services.syncfusion.com/js/production/api/UrlDataSource").Adaptor("UrlAdaptor")).Query("query").Height("450").ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).EnableDomVirtualization(true).DomVirtualizationSettings(d => d.RowBuffer(6).AutoRowHeight(true).VirtualDomType("Row")).EnableVirtualMaskRow(true).EnableVirtualization().PageSettings(p => p.PageSize(50)).AllowSorting().AllowFiltering().FilterSettings(f => f.Type(Syncfusion.EJ2.Grids.FilterType.CheckBox)).Toolbar(new List<string>() { "Search" }).Columns(col =>
{
    col.Field("EmployeeID").HeaderText("Employee ID").Width("110").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).IsPrimaryKey(true).Type("number").Template("#empIdTemplate").Add();
    col.Field("Employees").HeaderText("Employee Name").Width("160").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Template("#empNameTemplate").Add();
    col.Field("Designation").HeaderText("Designation").Width("140").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Template("#desigTemplate").Add();
    col.Field("Mail").HeaderText("Email").Width("190").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Add();
    col.Field("Address").HeaderText("Address").Width("190").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Add();
    col.Field("Location").HeaderText("Location").Width("130").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Template("#locTemplate").Add();
    col.Field("Status").HeaderText("Status").Width("120").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Template("#statusTemplate").Add();
    col.Field("Trustworthiness").HeaderText("Trustworthiness").Width("140").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Template("#trustTemplate").Add();
    col.Field("Software").HeaderText("Software Skills").Width("130").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Type("number").Template("#softTemplate").Add();
    col.Field("Rating").HeaderText("Performance Rating").Width("140").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Type("number").Template("#ratingTemplate").Add();
    col.Field("CurrentSalary").HeaderText("Current Salary").Width("140").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).ClipMode(Syncfusion.EJ2.Grids.ClipMode.EllipsisWithTooltip).Type("number").Template("#salaryTemplate").Add();
}).Render()

<script type="text/x-template" id="empIdTemplate">
    <span>${EmployeeID}</span>
</script>
<script type="text/x-template" id="empNameTemplate">
    <span class="vp-ellipsis">${Employees}</span>
</script>
<script type="text/x-template" id="desigTemplate">
    <span class="vp-ellipsis">${Designation}</span>
</script>
<script type="text/x-template" id="locTemplate">
    <span class="vp-ellipsis">${Location}</span>
</script>
<script type="text/x-template" id="statusTemplate">
    ${getStatusHtml(Status)}
</script>
<script type="text/x-template" id="trustTemplate">
    <div class="vp-badge vp-trust-${Trustworthiness}">${Trustworthiness}</div>
</script>
<script type="text/x-template" id="softTemplate">
    ${getSoftwareHtml(Software, Trustworthiness)}
</script>
<script type="text/x-template" id="ratingTemplate">
    ${getRatingHtml(Rating, Trustworthiness)}
</script>
<script type="text/x-template" id="salaryTemplate">
    <span class="vp-salary">${formatSalary(CurrentSalary)}</span>
</script>

<script>
    var query = new ej.data.Query().addParams('dataCount', '100000');

    function getStatusHtml(status) {
        var icons = { Active: '●', Inactive: '○', 'On Leave': '⊘', Retired: '✕' };
        var cls = (status || 'Active').replace(' ', '');
        return '<div class="vp-badge vp-status-' + cls + '"><span>' + (icons[status] || icons.Active) + '</span><span>' + status + '</span></div>';
    }
    function getSoftwareHtml(software, trust) {
        var v = Math.round(Math.min(100, Math.max(0, Number(software == null ? 0 : software))));
        if (trust === 'Perfect' && v < 70) v = 70;
        else if (trust === 'Sufficient') v = Math.min(69, Math.max(40, v));
        else if (trust === 'Insufficient' && v > 39) v = 39;
        var color = v < 40 ? '#dc2626' : v < 70 ? '#f59e0b' : '#059669';
        return '<div class="vp-progress"><div class="vp-progress-bar"><div style="width:' + v + '%;background-color:' + color + '"></div></div><span>' + v + '%</span></div>';
    }
    function getRatingHtml(rating, trust) {
        var r = Math.min(5, Math.max(0, Number(rating == null ? 0 : rating)));
        if (trust === 'Perfect') r = Math.min(5, Math.max(4, r));
        else if (trust === 'Sufficient') r = 3;
        else if (trust === 'Insufficient') r = Math.min(2, Math.max(1, r));
        var color = r >= 4 ? '#059669' : r >= 3 ? '#f59e0b' : '#dc2626';
        return '<span style="color:' + color + ';font-weight:600">★ ' + r.toFixed(1) + '</span>';
    }
    function formatSalary(value) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value || 0);
    }
</script>
