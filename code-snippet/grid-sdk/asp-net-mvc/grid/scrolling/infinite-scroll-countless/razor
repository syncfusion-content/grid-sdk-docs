@Html.EJS().Grid("grid").DataSource(dataManager => { dataManager.Url("https://services.syncfusion.com/js/production/api/UrlDataSource").Adaptor("UrlAdaptor"); }).EnableInfiniteScrolling().Height("300").Columns(col =>
{
    col.Field("EmployeeID").HeaderText("Employee ID").Width("100").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
    col.Field("Employees").HeaderText("Employee Name").Width("120").Add();
    col.Field("Designation").HeaderText("Designation").Width("100").Add();
    col.Field("Location").HeaderText("Location").Width("100").Add();
    col.Field("CurrentSalary").HeaderText("Salary").Format("C2").Width("100").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
}).PageSettings(page => { page.PageSize(50); }).InfiniteScrollSettings(scroll => { scroll.EnableCountLessMode(true); }).Render()