<ejs-grid id="Grid" dataSource="@ViewBag.DataSource" enableAutoFill="true">
    <e-grid-selectionsettings mode="Cell" cellSelectionMode="Box" type="Multiple"></e-grid-selectionsettings>
    <e-grid-editsettings allowEditing="true" mode="Cell"></e-grid-editsettings>
    <e-grid-columns>
        <e-grid-column field="Id" headerText="ID" isPrimaryKey="true" width="100" validationRules="@(new { required = true })"></e-grid-column>
        <e-grid-column field="Product" headerText="Product Name" width="180" validationRules="@(new { required = true })"></e-grid-column>
        <e-grid-column field="Quantity" headerText="Quantity" textAlign="Right" width="120"></e-grid-column>
        <e-grid-column field="Price" headerText="Price Per Unit" textAlign="Right" format="C2" editType="numericedit" width="140"></e-grid-column>
        <e-grid-column field="GrossAmount" headerText="Gross Amount" allowFormula="true" format="C2" width="150" allowEditing="false"></e-grid-column>
        <e-grid-column field="TaxAmount" headerText="Tax Amount" textAlign="Right" allowFormula="true" format="C2" width="130"></e-grid-column>
        <e-grid-column field="TotalAmount" headerText="Total Amount" textAlign="Right" allowFormula="true" format="C2" width="150"></e-grid-column>
    </e-grid-columns>
</ejs-grid>