<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
    <label for="searchMode">Search Mode</label>
    @Html.EJS().DropDownList("searchMode").DataSource((IEnumerable<object>)ViewBag.searchModes).Fields(e => e.Text("text").Value("value")).Value("Default").Change("onSearchModeChange").Width("140px").Render()
</div>
@Html.EJS().Grid("Grid").DataSource((IEnumerable<object>)ViewBag.datasource).Height(400).Width("100%").SearchSettings(search => search.Mode(SearchMode.Default)).Columns(col =>
{
    col.Field("OrderID").HeaderText("Order ID").Width("160").Add();
    col.Field("CustomerID").HeaderText("Customer ID").Width("170").Add();
    col.Field("ShipName").HeaderText("Ship Name").Width("170").Add();
    col.Field("ShipCity").HeaderText("Ship City").Width("140").Add();
}).Created("created").Toolbar(new List<string>() { "Search" }).Render()
<script>
    var currentSearchSettings = { mode: 'Default' };
    
    function created() {
        var grid = document.getElementById("Grid").ej2_instances[0];
        document.getElementById(grid.element.id + "_searchbar").addEventListener('keyup', () => {
            grid.search(event.target.value)
        });
    }

    function onSearchModeChange(args) {
        var grid = document.getElementById("Grid").ej2_instances[0];
        grid.searchSettings = {
            mode: args.value,
            immediateModeDelay: args.value === 'Immediate' ? 1500 : 0
        };
    }
</script>