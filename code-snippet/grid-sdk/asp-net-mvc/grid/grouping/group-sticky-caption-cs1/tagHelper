<ejs-grid id="grid" dataSource="@ViewBag.dataSource" allowGrouping="true" height="400px">
    <e-grid-groupsettings columns="@(new string[] {"state","portfolioType"})" defaultExpanded="1" enableSticky="true"></e-grid-groupsettings>
    <e-grid-columns>
        <e-grid-column field="accountId" headerText="Account ID" width="140"></e-grid-column>
        <e-grid-column field="fullName" headerText="Full Name" width="150"></e-grid-column>
        <e-grid-column field="state" headerText="State" width="130"></e-grid-column>
        <e-grid-column field="portfolioType" headerText="Portfolio Type" width="140"></e-grid-column>
        <e-grid-column field="balanceUsd" headerText="Balance (USD)" textAlign="Right" width="140"></e-grid-column>
        <e-grid-column field="ytdReturnPct" headerText="YTD Return %" textAlign="Right" width="130"></e-grid-column>
        <e-grid-column field="riskLevel" headerText="Risk Level" width="120"></e-grid-column>
    </e-grid-columns>
</ejs-grid>