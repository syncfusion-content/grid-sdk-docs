<div class="controls" style="padding: 10px 0">
    <button class="e-btn" id="updatePrices">Update prices</button>
</div>
@Html.EJS().Grid("Grid").DataSource((IEnumerable<object>)ViewBag.DataSource).EnableHighlightOnDataChange(true).Height("300").Columns(col =>
{
	col.Field("Symbol").HeaderText("Symbol").IsPrimaryKey(true).Width("110").Add();
	col.Field("Company").HeaderText("Company").Width("180").Add();
	col.Field("Price").HeaderText("Price").Format("C2").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Width("120").Add();
	col.Field("Volume").HeaderText("Volume").Format("N0").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Width("140").Add();
}).Render()
<script>
    document.getElementById('updatePrices').addEventListener('click', function () {
        var grid = document.getElementById('Grid').ej2_instances[0];
        var symbols = ['AAPL', 'NVDA', 'TSLA'];
        symbols.forEach((symbol) => {
            grid.setCellValue(symbol, 'Price', +(100 + Math.random() * 150).toFixed(2));
        });
    });
</script>
