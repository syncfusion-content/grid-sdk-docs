<ejs-grid id="grid" dataSource="@ViewBag.dataSource" height="320px" enableToolPanel="true">
    <e-grid-editSettings allowEditing="true" mode="Normal"></e-grid-editSettings>
    <e-grid-selectionsettings type="Multiple"></e-grid-selectionsettings>
    <e-grid-columns>
        <e-grid-column field="EmployeeID" headerText="Employee ID" width="140" textAlign="Right" isPrimaryKey="true"></e-grid-column>
        <e-grid-column field="Name" headerText="Name" width="140"></e-grid-column>
        <e-grid-column field="Title" headerText="Title" width="140"></e-grid-column>
        <e-grid-column field="Country" headerText="Country" width="140"></e-grid-column>
        <e-grid-column field="Salary" headerText="Salary" width="140" textAlign="Right" format="C0"></e-grid-column>
    </e-grid-columns>
    <e-grid-toolpanelsettings position="Right" type="Push" width="300">
        <e-toolpanels>
            <e-toolpanel type="Edit"></e-toolpanel>
            <e-toolpanel type="Columns"></e-toolpanel>
        </e-toolpanels>
    </e-grid-toolpanelsettings>
</ejs-grid>
