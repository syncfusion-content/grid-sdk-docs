<ejs-grid id="grid" dataSource="@ViewBag.dataSource" height="320px" enableToolPanel="true" allowFiltering="true" allowGrouping="true" allowReordering="true">
    <e-grid-columns>
        <e-grid-column field="OrderID" headerText="Order ID" width="140" textAlign="Right"></e-grid-column>
        <e-grid-column field="CustomerID" headerText="Customer ID" width="140"></e-grid-column>
        <e-grid-column field="ShipCity" headerText="Ship City" width="140"></e-grid-column>
        <e-grid-column field="ShipCountry" headerText="Ship Country" width="140"></e-grid-column>
        <e-grid-column field="Freight" headerText="Freight" width="140" textAlign="Right" format="C2"></e-grid-column>
    </e-grid-columns>
    <e-grid-toolpanelsettings position="Right" type="Push" width="300">
        <e-toolpanels>
            <e-toolpanel type="Columns"></e-toolpanel>
            <e-toolpanel type="Filters"></e-toolpanel>
        </e-toolpanels>
    </e-grid-toolpanelsettings>
    <e-grid-columnchoosersettings allowReordering="true"></e-grid-columnchoosersettings>
</ejs-grid>
